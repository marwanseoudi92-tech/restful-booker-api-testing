        {
          "name": "Partial Update",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const patchBody = JSON.parse(pm.request.body.raw);\r\n\r\npm.collectionVariables.set(\r\n    \"patchBody\",\r\n    JSON.stringify(patchBody)\r\n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\nconst original = JSON.parse(\r\n    pm.collectionVariables.get(\"createdBooking\")\r\n);\r\n\r\nconst patch = JSON.parse(\r\n    pm.collectionVariables.get(\"patchBody\")\r\n);\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.expect(pm.response.code).to.eql(200);\r\n});\r\n\r\n\r\n// Check that every patched field was actually updated\r\n\r\nObject.keys(patch).forEach(function (field) {\r\n\r\n    pm.test(`${field} was updated`, function () {\r\n        pm.expect(response[field]).to.eql(patch[field]);\r\n    });\r\n\r\n});\r\n\r\n\r\n// Check fields that were NOT patched\r\n\r\nObject.keys(original).forEach(function (field) {\r\n\r\n    if (field !== \"bookingdates\" && !(field in patch)) {\r\n\r\n        pm.test(`${field} remains unchanged`, function () {\r\n            pm.expect(response[field]).to.eql(original[field]);\r\n        });\r\n\r\n    }\r\n\r\n});\r\npm.collectionVariables.set(\"createdBooking\", JSON.stringify(response));"
                ]
              }
            }
          ],
