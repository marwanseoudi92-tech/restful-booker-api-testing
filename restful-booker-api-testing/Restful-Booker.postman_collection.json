      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has a bookingid field that is a number\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"bookingid\");\r",
                  "    pm.expect(jsonData.bookingid).to.be.a(\"number\");\r",
                  "    pm.collectionVariables.set(\"bookingid\", jsonData.bookingid);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has a booking object\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"booking\");\r",
                  "    pm.expect(jsonData.booking).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.firstname equals 'Ahmed'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.firstname).to.eql(\"Ahmed\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.lastname equals 'Khaled'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.lastname).to.eql(\"Khaled\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.totalprice equals 200\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.totalprice).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.depositpaid equals true\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.depositpaid).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.bookingdates.checkin equals '2026-01-01'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.bookingdates.checkin).to.eql(\"2026-01-01\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.bookingdates.checkout equals '2026-03-31'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.bookingdates.checkout).to.eql(\"2026-03-31\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"booking.additionalneeds equals 'Dinner'\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.booking.additionalneeds).to.eql(\"Dinner\");\r",
                  "});\r",
                  "\r",
                  "const requestBody = JSON.parse(pm.request.body.raw);\r",
                  "pm.collectionVariables.set(\"createdBooking\", JSON.stringify(requestBody));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
