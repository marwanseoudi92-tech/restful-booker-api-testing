        {
          "name": "Get Created Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "const expected = JSON.parse(",
                  "    pm.collectionVariables.get(\"createdBooking\")",
                  ");",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"First name matches\", function () {",
                  "    pm.expect(response.firstname).to.eql(expected.firstname);",
                  "});",
                  "",
                  "pm.test(\"Last name matches\", function () {",
                  "    pm.expect(response.lastname).to.eql(expected.lastname);",
                  "});",
                  "",
                  "pm.test(\"Total price matches\", function () {",
                  "    pm.expect(response.totalprice).to.eql(expected.totalprice);",
                  "});",
                  "",
                  "pm.test(\"Deposit status matches\", function () {",
                  "    pm.expect(response.depositpaid).to.eql(expected.depositpaid);",
                  "});",
                  "",
                  "pm.test(\"Check-in date matches\", function () {",
                  "    pm.expect(response.bookingdates.checkin)",
                  "        .to.eql(expected.bookingdates.checkin);",
                  "});",
                  "",
                  "pm.test(\"Check-out date matches\", function () {",
                  "    pm.expect(response.bookingdates.checkout)",
                  "        .to.eql(expected.bookingdates.checkout);",
                  "});",
                  "",
                  "pm.test(\"Additional needs matches\", function () {",
                  "    pm.expect(response.additionalneeds)",
                  "        .to.eql(expected.additionalneeds);",
                  "});"
                ],
