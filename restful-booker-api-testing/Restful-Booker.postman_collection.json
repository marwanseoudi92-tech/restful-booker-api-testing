        {
          "name": "Update Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const requestBody = JSON.parse(pm.request.body.raw);\r\n\r\npm.collectionVariables.set(\r\n    \"updatedBooking\",\r\n    JSON.stringify(requestBody)\r\n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\nconst expected = JSON.parse(\r\n    pm.collectionVariables.get(\"updatedBooking\")\r\n);\r\n\r\npm.test(\"Firstname matches request\", function () {\r\n    pm.expect(response.firstname).to.eql(expected.firstname);\r\n});\r\n\r\npm.test(\"Lastname matches request\", function () {\r\n    pm.expect(response.lastname).to.eql(expected.lastname);\r\n});\r\n\r\npm.test(\"Total price matches request\", function () {\r\n    pm.expect(response.totalprice).to.eql(expected.totalprice);\r\n});\r\n\r\npm.test(\"Deposit status matches request\", function () {\r\n    pm.expect(response.depositpaid).to.eql(expected.depositpaid);\r\n});\r\n\r\npm.test(\"Check-in matches request\", function () {\r\n    pm.expect(response.bookingdates.checkin)\r\n        .to.eql(expected.bookingdates.checkin);\r\n});\r\n\r\npm.test(\"Check-out matches request\", function () {\r\n    pm.expect(response.bookingdates.checkout)\r\n        .to.eql(expected.bookingdates.checkout);\r\n});\r\npm.collectionVariables.set(\"createdBooking\", JSON.stringify(response));"
                ]
              }
            }
